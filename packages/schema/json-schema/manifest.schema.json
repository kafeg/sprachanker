{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "series": {
      "$ref": "#/$defs/SeriesKey"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "providerVersion": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "licence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "attribution",
        "url"
      ],
      "additionalProperties": false
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "course",
              "exam"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$",
            "description": "BCP-47 primary language subtag"
          },
          "editions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}-[a-z]{2,3}$",
                  "description": "Edition id <source>-<target>"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}$",
                  "description": "BCP-47 primary language subtag"
                },
                "fetchedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "contentVersion": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "source",
                "fetchedAt",
                "contentVersion"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "target",
          "editions"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[^\\\\]+$",
        "title": "LibraryPath"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mime": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "durationSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "series",
    "provider",
    "providerVersion",
    "title",
    "licence",
    "courses",
    "files"
  ],
  "additionalProperties": false,
  "$defs": {
    "SeriesKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "title": "SeriesKey",
      "description": "<publisher>.<series>"
    }
  }
}
