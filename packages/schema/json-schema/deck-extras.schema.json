{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "words": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "audio": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^media\\/[^/\\\\]+$"
              },
              "engine": {
                "type": "string",
                "enum": [
                  "piper",
                  "qwen"
                ]
              },
              "voice": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "made": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "engine",
              "voice",
              "text",
              "made"
            ],
            "additionalProperties": false
          },
          "examples": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}$",
              "description": "BCP-47 primary language subtag"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "items": {
                  "minItems": 1,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sentence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "translation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "glossary": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "word": {
                              "type": "string"
                            },
                            "translation": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "word",
                            "translation"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "form": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sentence",
                      "translation"
                    ],
                    "additionalProperties": false
                  }
                },
                "model": {
                  "type": "string"
                },
                "made": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "items",
                "model",
                "made"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "words"
  ],
  "additionalProperties": false
}
