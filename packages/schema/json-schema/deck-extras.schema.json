{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "words": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "audio": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^media\\/[^/\\\\]+$"
              },
              "engine": {
                "type": "string",
                "enum": [
                  "piper",
                  "qwen"
                ]
              },
              "voice": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "made": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "engine",
              "voice",
              "text",
              "made"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "words"
  ],
  "additionalProperties": false
}
