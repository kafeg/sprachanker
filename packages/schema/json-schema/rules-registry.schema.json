{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/RuleId"
      },
      "title": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$",
          "description": "BCP-47 primary language subtag"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "explanation": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$",
          "description": "BCP-47 primary language subtag"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "examples": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "id",
      "title",
      "explanation",
      "examples"
    ]
  },
  "$defs": {
    "RuleId": {
      "type": "string",
      "pattern": "^(?:[a-z]{2,3}\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "title": "RuleId",
      "description": "<lang>.<area>.<slug>"
    }
  }
}
