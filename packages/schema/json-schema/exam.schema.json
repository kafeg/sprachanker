{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "key": {
      "$ref": "#/$defs/ExamKey"
    },
    "timeLimitSec": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "timeLimitSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "scaleTo": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "round": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "timeLimitSec"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/$defs/ExamSectionKey"
          },
          "pool": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/ExamItemKey"
            }
          },
          "draw": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "filter": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "setting": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "tag",
                  "setting"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string"
          },
          "media": {
            "$ref": "#/$defs/Media"
          },
          "letters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "letter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2
                },
                "text": {
                  "type": "string"
                },
                "media": {
                  "$ref": "#/$defs/Media"
                }
              },
              "required": [
                "letter"
              ],
              "additionalProperties": false
            }
          },
          "plays": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "examples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ExamItemKey"
            }
          }
        },
        "required": [
          "key",
          "pool",
          "draw",
          "filter"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ExamItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Option"
                }
              },
              "answer": {
                "type": "object",
                "properties": {
                  "optionIds": {
                    "minItems": 1,
                    "maxItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]{1,2}$"
                    }
                  }
                },
                "required": [
                  "optionIds"
                ],
                "additionalProperties": false
              },
              "tags": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "single_choice"
              }
            },
            "required": [
              "key",
              "options",
              "answer",
              "tags",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ExamItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "segments": {
                "$ref": "#/$defs/Segments"
              },
              "answer": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^g[1-9]\\d*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "accepted"
                  ],
                  "additionalProperties": false
                }
              },
              "tags": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "gap_text"
              }
            },
            "required": [
              "key",
              "segments",
              "answer",
              "tags",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ExamItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "input": {
                "type": "string",
                "enum": [
                  "text",
                  "speech"
                ]
              },
              "rubric": {
                "type": "object",
                "properties": {
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "anyOf": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "id",
                        "anyOf"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "criteria": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "required",
                  "criteria"
                ],
                "additionalProperties": false
              },
              "reference": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answerIn": {
                "type": "string",
                "enum": [
                  "target",
                  "learner"
                ]
              },
              "tags": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "respond"
              }
            },
            "required": [
              "key",
              "input",
              "reference",
              "tags",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "thresholds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minPoints": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "minPoints"
        ],
        "additionalProperties": false
      }
    },
    "roundTotal": {
      "type": "boolean"
    },
    "passWhen": {
      "type": "string",
      "enum": [
        "any",
        "all"
      ]
    }
  },
  "required": [
    "format",
    "key",
    "timeLimitSec",
    "sections",
    "items",
    "thresholds"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExamKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/exam-[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "title": "ExamKey",
      "description": "<course>/exam-<slug>"
    },
    "ExamSectionKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/exam-[a-z0-9]+(?:-[a-z0-9]+)*\\/s-[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "title": "ExamSectionKey",
      "description": "<exam>/s-<slug>"
    },
    "ExamItemKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/exam-[a-z0-9]+(?:-[a-z0-9]+)*\\/q-[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "title": "ExamItemKey",
      "description": "<exam>/q-<id>"
    },
    "Media": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/MediaPath"
        },
        "audio": {
          "$ref": "#/$defs/MediaPath"
        },
        "video": {
          "$ref": "#/$defs/MediaPath"
        },
        "credit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "MediaPath": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[^\\\\]+$"
        },
        {
          "pattern": "^media\\/[^/]+\\/.+$"
        }
      ],
      "title": "MediaPath"
    },
    "Option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{1,2}$"
        },
        "text": {
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/Media"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "Segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "gap": {
                "type": "string",
                "pattern": "^g[1-9]\\d*$"
              }
            },
            "required": [
              "gap"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
