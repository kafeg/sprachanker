{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "lesson": {
      "$ref": "#/$defs/LessonKey"
    },
    "rules": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleId"
      }
    },
    "notes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}$",
        "description": "BCP-47 primary language subtag"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "exercises": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ExerciseKey"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/RuleId"
            }
          },
          "accepted": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^#[1-9]\\d*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^g[1-9]\\d*$"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "extra": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "after": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExerciseKey"
              },
              {
                "type": "string",
                "const": "end"
              }
            ]
          },
          "exercise": {
            "oneOf": [
              {
                "$ref": "#/$defs/single_choice_exercise"
              },
              {
                "$ref": "#/$defs/multi_choice_exercise"
              },
              {
                "$ref": "#/$defs/match_exercise"
              },
              {
                "$ref": "#/$defs/order_exercise"
              },
              {
                "$ref": "#/$defs/gap_choice_exercise"
              },
              {
                "$ref": "#/$defs/gap_text_exercise"
              },
              {
                "$ref": "#/$defs/dictation_exercise"
              },
              {
                "$ref": "#/$defs/speech_repeat_exercise"
              },
              {
                "$ref": "#/$defs/speech_selfrate_exercise"
              },
              {
                "$ref": "#/$defs/respond_exercise"
              },
              {
                "$ref": "#/$defs/unknown_exercise"
              }
            ]
          }
        },
        "required": [
          "after",
          "exercise"
        ],
        "additionalProperties": false
      }
    },
    "scenes": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneKey"
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "phrases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LexemeKey"
          }
        }
      },
      "required": [
        "phrases"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "lesson"
  ],
  "additionalProperties": false,
  "$defs": {
    "LessonKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/\\d{2,}-\\d{2,})$",
      "title": "LessonKey",
      "description": "<course>/<unit NN>-<lesson NN>"
    },
    "RuleId": {
      "type": "string",
      "pattern": "^(?:[a-z]{2,3}\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "title": "RuleId",
      "description": "<lang>.<area>.<slug>"
    },
    "ExerciseKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/\\d{2,}-\\d{2,}\\/(?:ex|x)-\\d{2,})$",
      "title": "ExerciseKey",
      "description": "<lesson>/ex-<NN> (source order) or <lesson>/x-<NN> (ours)"
    },
    "single_choice_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "single_choice"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "text": {
          "type": "string"
        },
        "newWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabKey"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Option"
                }
              },
              "answer": {
                "type": "object",
                "properties": {
                  "optionIds": {
                    "minItems": 1,
                    "maxItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]{1,2}$"
                    }
                  }
                },
                "required": [
                  "optionIds"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "options",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "type",
        "fingerprint",
        "newWords",
        "ruleIds",
        "items"
      ],
      "additionalProperties": false
    },
    "Media": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/MediaPath"
        },
        "audio": {
          "$ref": "#/$defs/MediaPath"
        },
        "video": {
          "$ref": "#/$defs/MediaPath"
        },
        "poster": {
          "$ref": "#/$defs/MediaPath"
        },
        "credit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "MediaPath": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[^\\\\]+$"
        },
        {
          "pattern": "^media\\/[^/]+\\/.+$"
        }
      ],
      "title": "MediaPath"
    },
    "VocabKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/\\d{2,}-\\d{2,}\\/v-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]+(?:-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]+)*(?:\\.(?:[2-9]|[1-9]\\d+))?)$",
      "title": "VocabKey",
      "description": "<lesson>/v-<lemma-slug>[.<n>]; .<n> (n ≥ 2) tells apart entries with the same lemma in a lesson"
    },
    "ItemKey": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/\\d{2,}-\\d{2,}\\/(?:ex|x)-\\d{2,}#[1-9]\\d*)$",
      "title": "ItemKey",
      "description": "<exercise>#<n>, 1-based"
    },
    "Option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{1,2}$"
        },
        "text": {
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/Media"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "multi_choice_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "multi_choice"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "text": {
          "type": "string"
        },
        "newWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabKey"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Option"
                }
              },
              "answer": {
                "type": "object",
                "properties": {
                  "optionIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]{1,2}$"
                    }
                  }
                },
                "required": [
                  "optionIds"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "options",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "type",
        "fingerprint",
        "newWords",
        "ruleIds",
        "items"
      ],
      "additionalProperties": false
    },
    "match_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "match"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "text": {
          "type": "string"
        },
        "newWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabKey"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "left": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Option"
                }
              },
              "right": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Option"
                }
              },
              "answer": {
                "type": "object",
                "properties": {
                  "pairs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^[a-z]{1,2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z]{1,2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                "required": [
                  "pairs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "left",
              "right",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "type",
        "fingerprint",
        "newWords",
        "ruleIds",
        "items"
      ],
      "additionalProperties": false
    },
    "order_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "order"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "text": {
          "type": "string"
        },
        "newWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabKey"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "parts": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Option"
                }
              },
              "join": {
                "type": "string",
                "enum": [
                  "space",
                  "none"
                ]
              },
              "answer": {
                "type": "object",
                "properties": {
                  "sequence": {
                    "minItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]{1,2}$"
                    }
                  }
                },
                "required": [
                  "sequence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "parts",
              "join",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "type",
        "fingerprint",
        "newWords",
        "ruleIds",
        "items"
      ],
      "additionalProperties": false
    },
    "gap_choice_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "gap_choice"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "text": {
          "type": "string"
        },
        "newWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabKey"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "segments": {
                "$ref": "#/$defs/Segments"
              },
              "gaps": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^g[1-9]\\d*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "options": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/Option"
                      }
                    }
                  },
                  "required": [
                    "options"
                  ],
                  "additionalProperties": false
                }
              },
              "display": {
                "type": "string",
                "enum": [
                  "dropdown",
                  "bank"
                ]
              },
              "answer": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^g[1-9]\\d*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z]{1,2}$"
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z]{1,2}$"
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "key",
              "segments",
              "gaps",
              "display",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "type",
        "fingerprint",
        "newWords",
        "ruleIds",
        "items"
      ],
      "additionalProperties": false
    },
    "Segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "gap": {
                "type": "string",
                "pattern": "^g[1-9]\\d*$"
              }
            },
            "required": [
              "gap"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "gap_text_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "gap_text"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "text": {
          "type": "string"
        },
        "newWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabKey"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ItemKey"
              },
              "media": {
                "$ref": "#/$defs/Media"
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "segments": {
                "$ref": "#/$defs/Segments"
              },
              "answer": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^g[1-9]\\d*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "accepted"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "key",
              "segments",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "type",
        "fingerprint",
        "newWords",
        "ruleIds",
        "items"
      ],
      "additionalProperties": false
    },
    "dictation_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "dictation"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "text": {
          "type": "string"
        },
        "newWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabKey"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/ItemKey"
              },
              "media": {
                "type": "object",
                "properties": {
                  "audio": {
                    "$ref": "#/$defs/MediaPath"
                  }
                },
                "required": [
                  "audio"
                ],
                "additionalProperties": false
              },
              "answerAudio": {
                "$ref": "#/$defs/MediaPath"
              },
              "prompt": {
                "type": "string"
              },
              "answer": {
                "type": "object",
                "properties": {
                  "accepted": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "accepted"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "media",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "type",
        "fingerprint",
        "newWords",
        "ruleIds",
        "items"
      ],
      "additionalProperties": false
    },
    "speech_repeat_exercise": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ExerciseKey"
        },
        "type": {
          "type": "string",
          "const": "speech_repeat"
        },
