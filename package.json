{
  "name": "sprachanker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/cli",
    "courses/_fixture"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "boundaries": "depcruise packages apps courses scripts e2e",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "dependency-cruiser": "18.5.0",
    "typescript": "6.0.3"
  }
}
