{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SprachAnker",
  "version": "../../cli/package.json",
  "identifier": "app.sprachanker.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
